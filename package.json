{
  "name": "copilot-bridge",
  "displayName": "Copilot Bridge",
  "description": "Personal AI assistant backed by GitHub Copilot via the VS Code Language Model API.",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.133.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotBridge.open",
        "title": "打开助手面板",
        "category": "Copilot Bridge"
      },
      {
        "command": "copilotBridge.ping",
        "title": "Ping model",
        "category": "Copilot Bridge"
      }
    ],
    "chatParticipants": [
      {
        "id": "copilotBridge.assistant",
        "name": "bridge",
        "fullName": "Copilot Bridge",
        "description": "个人 AI 助手,由 GitHub Copilot 模型驱动",
        "isSticky": true
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotBridge",
          "title": "Copilot Bridge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "copilotBridge": [
        {
          "type": "webview",
          "id": "copilotBridge.panel",
          "name": "Assistant"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.134.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
